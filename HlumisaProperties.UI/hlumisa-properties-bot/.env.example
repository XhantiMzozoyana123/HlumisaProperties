# =====================================================
# Hlumisa Properties - Standalone Messenger Bot
# Official Meta (Facebook) Graph API v21.0
# (No browser automation / no Puppeteer)
# =====================================================

# --- Meta / Facebook Messenger (Graph API) ---
# Page Access Token from https://developers.facebook.com/apps/
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here

# Webhook verify token - must match the value configured
# in your Facebook App webhook AND in HlumisaProperties.Api
# appsettings.json -> "Facebook:VerifyToken"
FACEBOOK_VERIFY_TOKEN=your_verify_token_here

# --- Server ---
MESSENGER_BOT_PORT=3001

# --- AI / LLM (generates the chatbot responses) ---
LLM_BASE_URL=http://63.141.255.202:11434
LLM_MODEL=llama3:latest
